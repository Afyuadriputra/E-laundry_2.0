# Application
APP_ENV=development
APP_NAME=Laundry UMKM API
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://laundry_app:REPLACE_PASSWORD@localhost:5432/laundry_dev

# Security - replace with strong random secrets
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
CSRF_SECRET=REPLACE_WITH_RANDOM_SECRET

# API / Frontend
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Business Defaults
BUSINESS_TIMEZONE=Asia/Jakarta